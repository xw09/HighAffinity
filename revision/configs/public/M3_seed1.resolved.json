{
  "source_config": "revision/configs/public/M3_seed1.yaml",
  "experiment": "M3",
  "description": "classification-only focal objective",
  "parameters": {
    "out_dir": "${HIGH_AFFINITY_PROCESSED_DIR}",
    "ckpt_path": "revision/runs/M3_seed1",
    "cache": "${BOLTZ_CACHE}",
    "pretrained_ckpt": "${BOLTZ_CACHE}/boltz2_aff.ckpt",
    "validation_ids_path": "revision/data/splits/validation_ids.txt",
    "train_ids_path": "revision/data/splits/train_ids.txt",
    "max_epochs": 8,
    "batch_size": 3,
    "devices": 1,
    "precision": "bf16-mixed",
    "accelerator": "gpu",
    "accumulate_steps": 4,
    "num_workers": 8,
    "seed": 1,
    "base_lr": 0.0001,
    "regression_enabled": false,
    "classification_enabled": true,
    "regression_loss": "huber",
    "classification_loss": "focal",
    "lambda_reg": 1.0,
    "lambda_cls": 1.0,
    "huber_delta": 0.5,
    "focal_gamma": 1.0,
    "focal_alpha": null,
    "reset_affinity_on_load": false,
    "unfreeze_last_trunk_blocks": 0,
    "early_stopping_patience": 2,
    "resume_ckpt_path": null,
    "validation_only": false
  }
}
